# ── 匿名社区 · 数据库 ─────────────────────────────────────────────
# PostgreSQL (Neon)。Cloudflare Pages 上配此连接串；Neon Serverless HTTP 驱动
# 在 Workers 里可直接运行，无需 Hyperdrive。
DATABASE_URL=             # postgres://user:pass@host:port/db

# ── 独立管理入口 ─────────────────────────────────────────────────
# 管理员经 `Authorization: Bearer <ADMIN_TOKEN>` 访问审核接口，不进入公共身份体系。
# 未设置时审核接口一律 403。
ADMIN_TOKEN=

# ── 人机验证（可选） ─────────────────────────────────────────────
# Cloudflare Turnstile 密钥；配了之后写接口要求前端附带 captchaToken 且校验通过。
TURNSTILE_SECRET=

# ── 服务端口（仅本地/Docker 后端运行时生效，Vite dev 仍为 5173） ──
PORT=3000

# ── 双桥写路径 (方案 C，默认闭门) ────────────────────────────────
# POST /api/v1/claims/:id/narrow|formal 的写门面：留空即关闭（一律 501）。
CLAIMS_WRITE_ENABLED=